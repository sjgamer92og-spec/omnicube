{
	"schemaVersion": 1,
	"id": "omnicube",
	"version": "${version}",
	"name": "OmniCube",
	"description": "An all-in-one client-side toolkit: HUD, free look, container previews, name tags, chat tools, world markers, inventory tools, waypoints, macros and an adaptive performance module. Built for Minecraft 1.21.11.",
	"authors": [
		"sjgamer92og-spec"
	],
	"contact": {
		"homepage": "https://github.com/sjgamer92og-spec/omnicube",
		"sources": "https://github.com/sjgamer92og-spec/omnicube"
	},
	"license": "MIT",
	"icon": "assets/omnicube/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.omnicube.OmniCubeMod"
		],
		"client": [
			"dev.omnicube.client.OmniCubeClient"
		]
	},
	"mixins": [
		{
			"config": "omnicube.mixins.json",
			"environment": "client"
		},
		{
			"config": "omnicube.chat.mixins.json",
			"environment": "client"
		},
		{
			"config": "omnicube.culling.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": ">=0.141.0"
	}
}
